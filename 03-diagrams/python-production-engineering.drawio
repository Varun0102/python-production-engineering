        <mxCell id="page04-rules" value="THE CONTRACT (Pydantic)&lt;br&gt;category: one of the allowed categories&lt;br&gt;priority: a number 1 to 4 (not &quot;High&quot;, not &quot;Urgent&quot;)&lt;br&gt;team: one of the allowed teams&lt;br&gt;Only the agreed fields (no surprise &quot;customer_mood&quot;)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fontFamily=Comic Sans MS;fontSize=25;fontStyle=1;strokeWidth=4;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="page04-1">
